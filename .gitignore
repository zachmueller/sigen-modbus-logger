# Local configuration: inverter address, install paths, launchd label. Never commit.
config.json

# Captured data. Manifests carry the unit's model, serial and the address polled,
# so an archive identifies a specific installation -- see manifest_identity.
data/
logs/
*.bin
*.bin.gz
*.manifest.json
topology-baseline.json

# Full-map dumps: dump.py --json writes the serial number in plain text. Rooted, so
# the redacted excerpt under examples/ is still committable.
/dump-snapshot*.json
/*.dump.json

# Cloud deployment: account id, bucket, domain, Google client id and the read
# allowlist -- i.e. other people's email addresses. This repository is public.
# cloud.example.json carries the same keys with placeholder values and IS committed.
cloud.json

# Synthesized CloudFormation. cdk.out embeds cloud.json's values in the templates and
# in the Lambda assets, so it leaks everything cloud.json does.
cloud/infrastructure/cdk.out/
cloud/infrastructure/node_modules/
cloud/**/*.template.json

__pycache__/
*.py[cod]
.DS_Store
