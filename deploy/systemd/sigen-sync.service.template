# The offsite uploader, rendered by deploy/systemd/install-sync.sh via
# `config.py --render`. Do not install this file directly: the placeholders are filled
# from config.json.
#
# A second unit, separate from the logger, for the reason they are all separate:
# restarting it must not be able to interrupt capture. It reads rotated files and writes
# only its own ledger, so it is not a second client of the inverter and cannot be.
#
# Type=oneshot with a timer, not Restart=always: this is a job that finishes. It scans for
# pending files, uploads them and exits. Timing lives in sigen-sync.timer.

[Unit]
Description=Sigenergy archive offsite copy to S3
Documentation=https://github.com/zachmu/sigen-modbus-logger
Wants=network-online.target
After=network-online.target

# Same reason as the logger's: an image that has not been given a config must not spend
# its life failing every five minutes into a log nobody is watching yet.
ConditionPathExists=@INSTALL_DIR@/config.json

[Service]
Type=oneshot
# A normal user, not root. It needs the ~/.aws profile, which is that user's, and no
# privilege beyond reading the archive.
User=@USER@
WorkingDirectory=@INSTALL_DIR@
# -u so a stall is visible in the log while it is happening rather than after.
ExecStart=@PYTHON@ -u @INSTALL_DIR@/sync.py --once --data-dir @DATA_DIR@

# No Nice boost, deliberately: the logger is the latency-sensitive process here and must
# win any contention, including for the network. An upload is allowed to be slow.
IOSchedulingClass=idle

StandardOutput=append:@LOG_DIR@/sync.log
StandardError=append:@LOG_DIR@/sync.err

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# ProtectSystem=strict already makes the whole hierarchy read-only, home included, which
# is all boto3 needs to read ~/.aws/credentials. These two are the exceptions, because the
# ledger lives beside the archive and is the only thing this job writes.
ReadWritePaths=@DATA_DIR@ @LOG_DIR@
